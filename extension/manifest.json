{
  "manifest_version": 3,
  "name": "JD X-ray",
  "version": "0.2.0",
  "description": "Read the job behind the job post locally, with an optional bring-your-own-AI deep read.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["https://api.openai.com/*", "https://openrouter.ai/*", "https://api.groq.com/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_title": "Analyze this job description"},
  "side_panel": {"default_path": "sidepanel.html"}
}
